{
  "name": "Jarvis Voice Git Automation Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis-git",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "webhook-jarvis-git",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "jarvis-git-webhook"
    },
    {
      "parameters": {
        "command": "python transcribe.py recorded_command.wav"
      },
      "id": "transcribe-cmd",
      "name": "Transcribe Audio",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "command": "python intent_router.py"
      },
      "id": "intent-router-cmd",
      "name": "Intent Router",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        700,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "command": "python execute_git.py"
      },
      "id": "git-action-cmd",
      "name": "Execute Git Command",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        940,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "command": "python speak.py \"Completed the task, sir.\""
      },
      "id": "speak-success-cmd",
      "name": "Spoken Confirmation (Success)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "command": "python speak.py \"Task failed, sir.\""
      },
      "id": "speak-error-cmd",
      "name": "Spoken Confirmation (Error)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1200,
        440
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Transcribe Audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transcribe Audio": {
      "main": [
        [
          {
            "node": "Intent Router",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Spoken Confirmation (Error)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Intent Router": {
      "main": [
        [
          {
            "node": "Execute Git Command",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Spoken Confirmation (Error)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Git Command": {
      "main": [
        [
          {
            "node": "Spoken Confirmation (Success)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Spoken Confirmation (Error)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "jarvis-git-v4",
  "id": "jarvis-git-workflow",
  "tags": []
}